# Copy to .env next to docker-compose.yml on the server

# ghcr.io/<owner>/<repo>, lowercase
IMAGE=ghcr.io/owner/pawnshop_sinclair

# URL-safe, e.g. openssl rand -hex 32
POSTGRES_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://example.com

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Zero Trust > Networks > Tunnels > the tunnel's install command
TUNNEL_TOKEN=

# Public key from age-keygen, the private key stays off the server
AGE_RECIPIENT=age1...
R2_BUCKET=pawnshop-backups
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
